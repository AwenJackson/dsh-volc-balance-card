{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "skipLibCheck": true,
    "noEmitOnError": false,
    "declaration": false,
    "sourceMap": false,
    "removeComments": false,
    "allowJs": false,
    "outDir": "lib",
    "rootDir": "src"
  },
  "include": ["src/index.ts", "src/client.ts"]
}
